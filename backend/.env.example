# Server
PORT=5000
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRES_IN=2h

# CORS (comma-separated allowlist; localhost is allowed by default)
# CORS_ORIGIN=http://localhost:3000

# Cookies (set true only when serving over HTTPS)
# COOKIE_SECURE=false

# MySQL Database (阿里云 RDS)
DB_HOST=rm-xxxxxxxxxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306       # 数据库端口（MySQL 默认 3306）
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=project1

# Aliyun OSS (direct upload policy + signed download)
OSS_REGION=cn-hongkong
OSS_BUCKET=your_bucket
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# Aliyun RTC
ALIYUN_RTC_APP_ID=
ALIYUN_RTC_APP_KEY=
# Classroom media provider. Default: aliyun-rtc-sdk. Set to legacy-live-push
# for an immediate rollback to the previous browser push/player implementation.
CLASSROOM_RTC_PROVIDER=aliyun-rtc-sdk

# Aliyun Model Studio / DashScope text embeddings
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_DIM=256
# Optional calibrated override for the "other course direction" cutoff
# MENTOR_DIRECTION_RELEVANCE_ABS_MIN=0.665
# Optional endpoint override
# DASHSCOPE_EMBEDDINGS_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding

# Aliyun ARTC cloud recording (Live OpenAPI + OSS output)
ALIYUN_LIVE_API_ACCESS_KEY_ID=
ALIYUN_LIVE_API_ACCESS_KEY_SECRET=
ALIYUN_ARTC_RECORD_REGION=ap-southeast-1
ALIYUN_ARTC_RECORD_ENDPOINT=live.ap-southeast-1.aliyuncs.com
ALIYUN_ARTC_RECORD_OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
ALIYUN_ARTC_RECORD_OSS_BUCKET=mentory-live-recordings-sg
ALIYUN_ARTC_RECORD_MAX_IDLE_SECONDS=300

# PayPal
# PAYPAL_ENV=sandbox|live (default: sandbox)
PAYPAL_ENV=sandbox
# Optional override for API base, e.g. https://api-m.paypal.com
# PAYPAL_API_BASE=

# Sandbox credentials
PAYPAL_SANDBOX_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_SANDBOX_CLIENT_SECRET=your_paypal_sandbox_client_secret

# Live credentials (required when PAYPAL_ENV=live)
PAYPAL_LIVE_CLIENT_ID=your_paypal_live_client_id
PAYPAL_LIVE_CLIENT_SECRET=your_paypal_live_client_secret

# FX pricing (Frankfurter)
# Public API base can be replaced with a self-hosted Frankfurter instance.
FRANKFURTER_API_BASE=https://api.frankfurter.dev
# Refresh the in-memory rate cache once per hour.
FX_CACHE_MINUTES=60
# Use the last successful rate during a temporary provider outage, up to 48 hours.
FX_MAX_STALE_HOURS=48
# Each price quote remains valid for 30 minutes.
FX_QUOTE_MINUTES=30
# Optional business FX protection in basis points. 0 = no markup; 200 = 2%.
FX_MARKUP_BPS=0
FX_REQUEST_TIMEOUT_MS=5000

# Aliyun DirectMail SMTP
MAIL_PROVIDER=aliyun_directmail_smtp
MAIL_HOST=smtpdm.aliyun.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=no-reply@example.com
MAIL_PASS=your_smtp_password
MAIL_FROM="Mentory <no-reply@example.com>"
# Optional: must be a public http(s) URL. Defaults to https://mentory.cc/Logo-removebg.png.
# Local files or cid attachments may show as Gmail attachments.
# MAIL_BRAND_LOGO_URL=https://example.com/Logo-removebg.png
# MAIL_PUBLIC_BASE_URL=https://example.com

# Email verification
EMAIL_CODE_LENGTH=6
EMAIL_CODE_EXPIRES_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_VERIFY_ATTEMPTS=5

# Mentor contract signing (DOCX -> LibreOffice PDF -> private OSS)
MENTOR_CONTRACT_VERSION=v1.1
# Optional override for the initial static full-agreement preview shown before a legal name is entered.
MENTOR_CONTRACT_PREVIEW_PDF_FILE=/opt/mentory/docs/contracts/templates/Mentory导师合作协议-v1.1-preview.pdf
# Optional absolute path; default resolves to docs/contracts/templates/Mentory导师合作协议-v1.1.docx
# MENTOR_CONTRACT_TEMPLATE_FILE=/opt/mentory/docs/contracts/templates/Mentory导师合作协议-v1.1.docx
MENTOR_CONTRACT_OSS_PREFIX=private/contracts/mentors
# Use a separate strong secret in production; falls back to EMAIL_CODE_SECRET/JWT_SECRET.
MENTOR_CONTRACT_CODE_SECRET=replace_with_a_long_random_secret
# Optional when LibreOffice is not on PATH. On Windows, Microsoft Word is used as a fallback converter.
LIBREOFFICE_BIN=/usr/bin/libreoffice
