{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "db:migrate:v2": "npm run build && node dist/scripts/migrate-v2.js",
    "db:migrate:refunds": "npm run build && node dist/scripts/migrate-refunds.js",
    "test:refunds": "node -r ts-node/register src/services/refundPricing.test.ts",
    "test:fx": "node -r ts-node/register src/services/fx.test.ts",
    "test:mail-template": "node -r ts-node/register src/services/mailService.test.ts",
    "test:embeddings": "node -r ts-node/register src/services/embeddingConfig.test.ts",
    "test:mentor-contract-render": "npm run build && node dist/scripts/test-mentor-contract-render.js",
    "test:mentor-payroll": "node -r ts-node/register src/services/mentorPayroll.test.ts",
    "db:migrate:vector": "npm run build && node dist/scripts/migrate-vector-index.js",
    "db:migrate:embedding-model": "npm run build && node dist/scripts/migrate-embedding-model.js",
    "cleanup:classroom-temp-files": "npm run build && node dist/scripts/cleanup-classroom-temp-files.js",
    "embed:courses": "npm run build && node dist/scripts/embed-course-mappings.js",
    "prune:courses": "npm run build && node dist/scripts/prune-course-mappings.js",
    "backfill:mentor-courses": "npm run build && node dist/scripts/backfill-mentor-course-embeddings.js",
    "backfill:mentor-direction-scores": "npm run build && node dist/scripts/backfill-mentor-direction-scores.js",
    "backfill:mentor-recommendation-stats": "npm run build && node dist/scripts/backfill-mentor-recommendation-stats.js",
    "backfill:course-sessions": "npm run build && node dist/scripts/backfill-course-sessions.js",
    "seed:mentor-cards": "npm run build && node dist/scripts/seed-mentor-cards.js",
    "seed:admin": "npm run build && node dist/scripts/seed-admin.js",
    "check:mentor-recommendation": "npm run build && node dist/scripts/check-mentor-recommendation.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@alicloud/live20161101": "^2.7.1",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "ali-oss": "^6.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.16.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.19",
    "@types/nodemailer": "^6.4.23",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
